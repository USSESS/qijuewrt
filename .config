
# ========== 多WAN负载均衡 mwan3（最新稳定版） ==========
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=yCONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_GENERIC=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
# ========== LuCI 管理界面 ==========
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-proto-ppp=y
# ========== 中文语言包（两个必须都有，缺一个半英文） ==========
CONFIG_PACKAGE_luci-i18n-zh-cn=yå
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# ========== 主题：只用 kijue 自定义主题 ==========
CONFIG_PACKAGE_luci-theme-kijue=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
# ========== DDNS-Go 动态域名 ==========
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_luci-app-ddns-go=y
CONFIG_PACKAGE_luci-i18n-ddns-go-zh-cn=y
# ========== 一键上网向导 netwizard ==========
CONFIG_PACKAGE_luci-app-netwizard=y
CONFIG_PACKAGE_luci-i18n-netwizard-zh-cn=y
# ========== iStore 软件商店 ==========
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-compat=y
# ========== 拨号组件 ==========
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_pppoe-discovery=y
# ========== 网页终端 ==========
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_kmod-macvlan=y
# ========== 包管理器全套 ==========
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_opkg-update=y
CONFIG_PACKAGE_opkg-conf=y
# ========== 网络下载工具 + HTTPS ==========
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_ca-certificates=y
# ========== Python3 ==========
CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_python3-base=y
# ========== 压缩解压工具 ==========
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_tar=y
# ========== 磁盘工具 ==========
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_e2fsprogs=y

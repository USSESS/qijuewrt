CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_GENERIC=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_GRUB_IMAGES=y
CONFIG_GRUB_EFI_IMAGES=y
CONFIG_TARGET_ROOTFS_PARTSIZE=2048
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# iStore商店 linkease feed 原生包名
CONFIG_PACKAGE_luci-app-store=y
# iStore强制依赖，缺少会菜单空白/打不开
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# 备用bootstrap主题；edge使用仓库内本地定制源码
CONFIG_PACKAGE_luci-theme-bootstrap=y
# mwan3多WAN负载均衡
CONFIG_PACKAGE_mwan3=y
CONFIG_PACKAGE_luci-app-mwan3=y
CONFIG_PACKAGE_luci-i18n-mwan3-zh-cn=y
# PPPoE拨号
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_pppoe-discovery=y
#一键上网设置向导
CONFIG_PACKAGE_luci-app-netwizard=y
CONFIG_PACKAGE_luci-i18n-netwizard-zh-cn=y
#网页终端
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_kmod-macvlan=y
# 本地定制edge主题编译进固件
CONFIG_PACKAGE_luci-theme-edge=y
#包管理器，必须开启，iStore才能正常工作
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_opkg-update=y
#iStore商店
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-compat=y
#上网向导+中文翻译
CONFIG_PACKAGE_luci-app-netwizard=y
CONFIG_PACKAGE_luci-i18n-netwizard-zh-cn=y
# ==========包管理器基础，装软件必备，绝对不能少==========
CONFIG_PACKAGE_opkg=y
CONFIG_PACKAGE_opkg-update=y
CONFIG_PACKAGE_opkg-conf=y

# wget/curl 下载工具，opkg更新源、iStore拉取插件需要
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget=y
CONFIG_PACKAGE_wget-ssl=y

# ca证书，https访问必备！没有这个iStore很多源访问失败
CONFIG_PACKAGE_ca-certificates=y

# python基础，大量第三方插件依赖（很多上网、监控工具需要）
CONFIG_PACKAGE_python3=y
CONFIG_PACKAGE_python3-base=y

# 网页终端ttyd（你已经有），方便后期调试
CONFIG_PACKAGE_ttyd=y

# iStore商店全套
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_luci-compat=y

# netwizard上网向导+中文包
CONFIG_PACKAGE_luci-app-netwizard=y
CONFIG_PACKAGE_luci-i18n-netwizard-zh-cn=y

# 解压工具，安装离线ipk包必备，后期本地装软件要用
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_gzip=y
CONFIG_PACKAGE_tar=y

# 磁盘工具，x86固件扩容、挂载硬盘
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_e2fsprogs=y


